# Copy this file to `.env` and fill in the key. Never commit `.env`.
# Get a key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-...

# Optional - DeepSeek-compatible API base URL and model.
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-flash

# Optional - the port the app server listens on (default 8000).
# PORT=8000
