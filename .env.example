# Copy this file to `.env` and fill in the key. Never commit `.env`.
# Get a key from https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Optional - the port the app server listens on (default 8000).
# PORT=8000

# Optional - enables PostgreSQL/PostGIS place discovery APIs.
# Replace YOUR_PASSWORD with the password set during PostgreSQL installation.
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/agetogether_db
